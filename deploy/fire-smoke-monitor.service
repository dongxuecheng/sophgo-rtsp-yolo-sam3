[Unit]
Description=BM1684X RTSP Frame Uploader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=linaro
WorkingDirectory=/data/sophgo-rtsp-yolo-sam3
ExecStart=/bin/bash /data/sophgo-rtsp-yolo-sam3/start.sh config/config.yaml --no-console
Restart=always
RestartSec=5
UMask=0077
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
